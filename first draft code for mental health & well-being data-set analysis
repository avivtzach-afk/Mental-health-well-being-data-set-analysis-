import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

# 1. Load dataset
df = pd.read_csv('/content/Mental Health Dataset.csv')

# 2. Filter subjects who received treatment ('Yes')
treated_df = df[df['treatment'].str.strip().str.lower() == 'yes'].copy()

# 3. Compute cross-tabulation table (Percentage of treated individuals per occupation by gender)
occ_by_gender = pd.crosstab(treated_df['Gender'], treated_df['Occupation'], normalize='index') * 100
print("Percentage of Occupations for Treated Individuals:")
display(occ_by_gender)

# 4. Set up side-by-side Pie Charts for Males and Females
fig, axes = plt.subplots(1, 2, figsize=(14, 6))

# Female Pie Chart
female_treated = treated_df[treated_df['Gender'] == 'Female']['Occupation'].value_counts()
axes[0].pie(
    female_treated,
    labels=female_treated.index,
    autopct='%1.1f%%',
    startangle=140,
    colors=sns.color_palette('Pastel1')
)
axes[0].set_title('Treated Females by Occupation', fontsize=13, fontweight='bold')

# Male Pie Chart
male_treated = treated_df[treated_df['Gender'] == 'Male']['Occupation'].value_counts()
axes[1].pie(
    male_treated,
    labels=male_treated.index,
    autopct='%1.1f%%',
    startangle=140,
    colors=sns.color_palette('Pastel2')
)
axes[1].set_title('Treated Males by Occupation', fontsize=13, fontweight='bold')

plt.tight_layout()
plt.show()
