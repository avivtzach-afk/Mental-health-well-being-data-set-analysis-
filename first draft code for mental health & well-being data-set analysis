import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

# ==============================================================================
# SECTION 1: DATA LOADING & INITIAL EXPLORATION
# ==============================================================================
# 1. Load dataset
df = pd.read_csv('/content/Mental Health Dataset.csv')

print("--- Dataset Head ---")
display(df.head())

print("\n--- Coping Struggles Counts ---")
print(df['Coping_Struggles'].value_counts())

# Inspect gender distribution & coping struggles cross-tabulation
user_genders = df['Gender']
keyword_matches = df[df['Coping_Struggles'].isin(['Yes', 'No'])]
crosstab_pct = pd.crosstab(df['Gender'], df['Coping_Struggles'], normalize='index') * 100

print("\n--- Coping Struggles Percentage by Gender ---")
display(crosstab_pct)


# ==============================================================================
# SECTION 2: VISUALIZATION 1 - COPING STRUGGLES BY GENDER
# ==============================================================================
sns.set_theme(style="whitegrid")

plt.figure(figsize=(8, 6))
ax = sns.countplot(
    data=df,
    x='Gender',
    hue='Coping_Struggles',
    palette='Set2'
)

plt.title('Coping Struggles by Gender', fontsize=14, fontweight='bold', pad=15)
plt.xlabel('Gender', fontsize=12)
plt.ylabel('Count', fontsize=12)
plt.legend(title='Coping Struggles', title_fontsize='11')

# Add numeric annotations above bars
for p in ax.patches:
    height = p.get_height()
    if height > 0:
        ax.annotate(
            f'{int(height):,}',
            (p.get_x() + p.get_width() / 2., height),
            ha='center', va='bottom',
            fontsize=10, xytext=(0, 3),
            textcoords='offset points'
        )

plt.tight_layout()
plt.show()


# ==============================================================================
# SECTION 3: TREATMENT & OCCUPATION ANALYSIS
# ==============================================================================
print("--- Value Counts for Treatment, Occupation, Gender ---")
print("Treatment values:\n", df['treatment'].value_counts(dropna=False))
print("\nOccupation values:\n", df['Occupation'].value_counts(dropna=False))
print("\nGender values:\n", df['Gender'].value_counts(dropna=False))

# Filter subjects receiving treatment ('Yes')
treated_df = df[df['treatment'].str.strip().str.lower() == 'yes'].copy()

# Group treated subjects by Gender and Occupation
gender_occ_counts = treated_df.groupby(['Gender', 'Occupation']).size().reset_index(name='count')
print("\n--- Treated Individuals by Gender and Occupation ---")
print(gender_occ_counts)


# ==============================================================================
# SECTION 4: VISUALIZATION 2 - TREATED SUBJECTS OVERVIEW PIE CHARTS
# ==============================================================================
plt.figure(figsize=(12, 6))

# Plot 2A: Gender breakdown of treated subjects
plt.subplot(1, 2, 1)
treated_gender = treated_df['Gender'].value_counts()
plt.pie(
    treated_gender,
    labels=treated_gender.index,
    autopct='%1.1f%%',
    startangle=140,
    colors=['#66b3ff', '#ff9999'],
    explode=(0.05, 0)
)
plt.title('Gender Breakdown\n(Treated Subjects)', fontsize=12, fontweight='bold')

# Plot 2B: Detailed occupation breakdown by gender for treated subjects
plt.subplot(1, 2, 2)
occ_gender = treated_df.groupby(['Gender', 'Occupation']).size().unstack()

labels = [f"{g} - {o}" for g in occ_gender.index for o in occ_gender.columns]
sizes = [occ_gender.loc[g, o] for g in occ_gender.index for o in occ_gender.columns]

plt.pie(
    sizes,
    labels=labels,
    autopct='%1.1f%%',
    startangle=90,
    pctdistance=0.85
)
plt.title('Occupation Breakdown by Gender\n(Treated Subjects)', fontsize=12, fontweight='bold')

plt.tight_layout()
plt.show()


# ==============================================================================
# SECTION 5: TREATMENT CORRELATION MATRIX
# ==============================================================================
df['treated_num'] = (df['treatment'].str.strip().str.lower() == 'yes').astype(int)
df['is_male'] = (df['Gender'].str.strip().str.lower() == 'male').astype(int)
df['is_female'] = (df['Gender'].str.strip().str.lower() == 'female').astype(int)

occ_dummies = pd.get_dummies(df['Occupation'], prefix='occ')
analysis_df = pd.concat([df[['treated_num', 'is_male', 'is_female']], occ_dummies], axis=1)

print("\n--- Correlation Matrix with Treatment ---")
print(analysis_df.corr()['treated_num'])


# ==============================================================================
# SECTION 6: VISUALIZATION 3 - TREATED OCCUPATIONS BY GENDER (FEMALE VS MALE)
# ==============================================================================
occ_by_gender = pd.crosstab(treated_df['Gender'], treated_df['Occupation'], normalize='index') * 100
print("\n--- Percentage of Occupations for Treated Individuals ---")
display(occ_by_gender)

fig, axes = plt.subplots(1, 2, figsize=(14, 6))

# Female Treated Occupation Pie
female_treated = treated_df[treated_df['Gender'] == 'Female']['Occupation'].value_counts()
axes[0].pie(
    female_treated,
    labels=female_treated.index,
    autopct='%1.1f%%',
    startangle=140,
    colors=sns.color_palette('Pastel1')
)
axes[0].set_title('Treated Females by Occupation', fontsize=13, fontweight='bold')

# Male Treated Occupation Pie
male_treated = treated_df[treated_df['Gender'] == 'Male']['Occupation'].value_counts()
axes[1].pie(
    male_treated,
    labels=male_treated.index,
    autopct='%1.1f%%',
    startangle=140,
    colors=sns.color_palette('Pastel2')
)
axes[1].set_title('Treated Males by Occupation', fontsize=13, fontweight='bold')

plt.tight_layout()
plt.show()


# ==============================================================================
# SECTION 7: VISUALIZATION 4 - TREATED NON-OCCUPIED GROUP (HOUSEWIFE, STUDENT, OTHERS)
# ==============================================================================
non_occupied_roles = ['Housewife', 'Student', 'Others']
treated_not_occ = df[(df['treatment'] == 'Yes') & (df['Occupation'].isin(non_occupied_roles))]

fig, axes = plt.subplots(1, 2, figsize=(14, 6))

# Female Non-Occupied Treated Pie
female_counts = treated_not_occ[treated_not_occ['Gender'] == 'Female']['Occupation'].value_counts()
axes[0].pie(
    female_counts,
    labels=female_counts.index,
    autopct='%1.1f%%',
    startangle=140,
    colors=sns.color_palette('Pastel1')
)
axes[0].set_title('Treated Females (Non-Occupied)', fontsize=13, fontweight='bold')

# Male Non-Occupied Treated Pie
male_counts = treated_not_occ[treated_not_occ['Gender'] == 'Male']['Occupation'].value_counts()
axes[1].pie(
    male_counts,
    labels=male_counts.index,
    autopct='%1.1f%%',
    startangle=140,
    colors=sns.color_palette('Pastel2')
)
axes[1].set_title('Treated Males (Non-Occupied)', fontsize=13, fontweight='bold')

plt.tight_layout()
plt.show()


# ==============================================================================
# SECTION 8: VISUALIZATION 5 - WORK INTEREST & MOOD SWINGS (NON-OCCUPIED)
# ==============================================================================
not_occ_df = df[df['Occupation'].isin(non_occupied_roles)].copy()
no_work_int_df = not_occ_df[not_occ_df['Work_Interest'] == 'No']

fig, axes = plt.subplots(1, 2, figsize=(14, 6))

# Chart 5A: Work Interest Breakdown Pie Chart
work_int = not_occ_df['Work_Interest'].value_counts()
axes[0].pie(
    work_int,
    labels=[f"No Work Interest\n({work_int['No']:,})", f"Maybe\n({work_int['Maybe']:,})", f"Has Work Interest\n({work_int['Yes']:,})"],
    autopct='%1.1f%%',
    startangle=140,
    colors=['#ff6b6b', '#fca311', '#4ecdc4'],
    explode=(0.08, 0, 0)
)
axes[0].set_title('Work Interest Breakdown\n(Non-Occupied Group)', fontsize=13, fontweight='bold')

# Chart 5B: Mood Swings for 'No Work Interest' by Gender
mood_df = no_work_int_df.groupby(['Gender', 'Mood_Swings']).size().unstack()
mood_df.plot(kind='bar', ax=axes[1], color=['#2b2d42', '#8d99ae', '#edf2f4'], edgecolor='black')

axes[1].set_title('Mood Swings Distribution for Subjects with\nNo Work Interest (Non-Occupied)', fontsize=13, fontweight='bold')
axes[1].set_xlabel('Gender', fontsize=11)
axes[1].set_ylabel('Subject Count', fontsize=11)
axes[1].legend(title='Mood Swings Level')
axes[1].set_xticklabels(axes[1].get_xticklabels(), rotation=0)

plt.tight_layout()
plt.show()


# ==============================================================================
# SECTION 9: VISUALIZATION 6 - HEATMAPS: COPING STRUGGLES BY MOOD SWINGS
# ==============================================================================
ct_female = pd.crosstab(
    df[df['Gender'] == 'Female']['Mood_Swings'],
    df[df['Gender'] == 'Female']['Coping_Struggles'],
    normalize='index'
) * 100

ct_male = pd.crosstab(
    df[df['Gender'] == 'Male']['Mood_Swings'],
    df[df['Gender'] == 'Male']['Coping_Struggles'],
    normalize='index'
) * 100

for gender in ['Female', 'Male']:
    sub = df[df['Gender'] == gender]
    coping_num = (sub['Coping_Struggles'].str.strip().str.lower() == 'yes').astype(int)
    mood_num = sub['Mood_Swings'].map({'Low': 0, 'Medium': 1, 'High': 2})
    print(f"Pearson Correlation - Mood Swings vs Coping Struggles ({gender}): {coping_num.corr(mood_num):.4f}")

fig, axes = plt.subplots(1, 2, figsize=(14, 5))

# Female Heatmap
sns.heatmap(
    ct_female,
    annot=True,
    fmt='.1f',
    cmap='PuRd',
    ax=axes[0],
    cbar_kws={'label': 'Percentage (%)'},
    linewidths=1,
    annot_kws={"size": 12, "weight": "bold"}
)
axes[0].set_title('Females: Coping Struggles by Mood Swings (%)', fontsize=12, fontweight='bold')
axes[0].set_xlabel('Coping Struggles', fontsize=11)
axes[0].set_ylabel('Mood Swings Level', fontsize=11)

# Male Heatmap
sns.heatmap(
    ct_male,
    annot=True,
    fmt='.1f',
    cmap='Blues',
    ax=axes[1],
    cbar_kws={'label': 'Percentage (%)'},
    linewidths=1,
    annot_kws={"size": 12, "weight": "bold"}
)
axes[1].set_title('Males: Coping Struggles by Mood Swings (%)', fontsize=12, fontweight='bold')
axes[1].set_xlabel('Coping Struggles', fontsize=11)
axes[1].set_ylabel('Mood Swings Level', fontsize=11)

plt.tight_layout()
plt.show()


# ==============================================================================
# SECTION 10: VISUALIZATION 7 - HEATMAPS: "NO WORK INTEREST" BY MOOD SWINGS
# ==============================================================================
df['mood_numeric'] = df['Mood_Swings'].map({'Low': 0, 'Medium': 1, 'High': 2})
df['no_work_interest'] = (df['Work_Interest'].str.strip() == 'No').astype(int)

correlations = {}
for gender in ['Female', 'Male']:
    sub_df = df[df['Gender'] == gender]
    r_val = sub_df['mood_numeric'].corr(sub_df['no_work_interest'])
    correlations[gender] = r_val
    print(f"Pearson Correlation - Mood Swings vs No Work Interest ({gender}): {r_val:.4f}")

fig, axes = plt.subplots(1, 2, figsize=(14, 5))

for idx, gender in enumerate(['Female', 'Male']):
    ct_pct = pd.crosstab(
        df[df['Gender'] == gender]['Mood_Swings'],
        df[df['Gender'] == gender]['no_work_interest'] == 1,
        normalize='index'
    ) * 100

    cmap = 'PuRd' if gender == 'Female' else 'Blues'

    sns.heatmap(
        ct_pct,
        annot=True,
        fmt='.1f',
        cmap=cmap,
        ax=axes[idx],
        cbar_kws={'label': 'Percentage (%)'},
        linewidths=1,
        annot_kws={"size": 12, "weight": "bold"}
    )

    axes[idx].set_title(
        f'{gender}s (Pearson r = {correlations[gender]:.4f})\n"No Work Interest" by Mood Swings (%)',
        fontsize=12,
        fontweight='bold'
    )
    axes[idx].set_xlabel('No Work Interest (True = Yes)', fontsize=11)
    axes[idx].set_ylabel('Mood Swings Level', fontsize=11)

plt.tight_layout()
plt.show()


# ==============================================================================
# SECTION 11: VISUALIZATION 8 - COMBINED FIGURE: OCCUPIED VS NON-OCCUPIED BAR + TREATED PIE
# ==============================================================================
df['Occupied_Status'] = df['Occupation'].apply(
    lambda x: 'Occupied' if x in ['Corporate', 'Business', 'Others'] else 'Non-Occupied'
)

fig, axes = plt.subplots(2, 1, figsize=(10, 11), gridspec_kw={'height_ratios': [1, 1.2]})

# --- TOP CHART: Occupied vs Non-Occupied Males and Females ---
status_counts = pd.crosstab(df['Gender'], df['Occupied_Status'])

ax1 = axes[0]
status_counts.plot(
    kind='bar',
    ax=ax1,
    color=['#e63946', '#2a9d8f'],
    edgecolor='black',
    width=0.6
)
ax1.set_title('Distribution of Occupied vs. Non-Occupied Males and Females', fontsize=13, fontweight='bold', pad=12)
ax1.set_xlabel('Gender', fontsize=11, labelpad=8)
ax1.set_ylabel('Count of Individuals', fontsize=11)
ax1.set_xticklabels(ax1.get_xticklabels(), rotation=0, fontsize=10)
ax1.legend(title='Employment Status', frameon=True)

# Add exact numeric annotations above bars
for p in ax1.patches:
    height = p.get_height()
    if height > 0:
        ax1.annotate(
            f'{int(height):,}',
            (p.get_x() + p.get_width() / 2., height),
            ha='center', va='bottom',
            fontsize=9, fontweight='bold', xytext=(0, 3),
            textcoords='offset points'
        )

# --- BOTTOM CHART: Treated by Occupation Pie Chart ---
ax2 = axes[1]
treated_counts = df[df['treatment'] == 'Yes']['Occupation'].value_counts()
colors = ['#457b9d', '#e76f51', '#f4a261', '#2a9d8f', '#e63946']

wedges, texts, autotexts = ax2.pie(
    treated_counts,
    labels=treated_counts.index,
    autopct='%1.1f%%',
    startangle=140,
    colors=colors,
    wedgeprops={'edgecolor': 'white', 'linewidth': 2},
    textprops={'fontsize': 11}
)

for autotext in autotexts:
    autotext.set_color('white')
    autotext.set_fontweight('bold')

ax2.set_title('Distribution of Individuals Receiving Mental Health Treatment by Occupation', fontsize=13, fontweight='bold', pad=12)

plt.tight_layout()
plt.show()


