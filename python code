import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
from scipy.stats import chi2_contingency

# Set global Seaborn theme
sns.set_theme(style="whitegrid")

def annotate_bars(ax, fmt="{:,.0f}", font_size=9):
    """Helper function to annotate bar heights across matplotlib plots."""
    for p in ax.patches:
        height = p.get_height()
        if height > 0:
            ax.annotate(
                fmt.format(height),
                (p.get_x() + p.get_width() / 2.0, height),
                ha='center', va='bottom',
                fontsize=font_size, fontweight='bold',
                xytext=(0, 3), textcoords='offset points'
            )

# ==============================================================================
# SECTION 1: DATA LOADING & PREPROCESSING
# ==============================================================================
df = pd.read_csv('/content/Mental Health Dataset.csv')

# Clean whitespace across string columns
str_cols = [
    'Gender', 'family_history', 'Mental_Health_History', 'treatment',
    'Mood_Swings', 'Work_Interest', 'Occupation', 'self_employed',
    'Days_Indoors', 'Social_Weakness', 'Coping_Struggles'
]
for col in str_cols:
    if col in df.columns:
        df[col] = df[col].astype(str).str.strip()

# Derived Features & Risk Profile
df['Risk_Profile'] = 'FamHist: ' + df['family_history'] + ' | MHHist: ' + df['Mental_Health_History']
df['Occupied_Status'] = df['Occupation'].apply(
    lambda x: 'Occupied' if x in ['Corporate', 'Business', 'Others'] else 'Non-Occupied'
)

# Indicator Flags for Outcome Analysis
df['High_Mood_Swings'] = (df['Mood_Swings'] == 'High').astype(int)
df['No_Work_Interest'] = (df['Work_Interest'] == 'No').astype(int)
df['Is_Self_Employed'] = (df['self_employed'] == 'Yes').astype(int)
df['Extended_Indoors'] = (df['Days_Indoors'].isin(['15-30 days', '30-60 days', 'More than 2 months'])).astype(int)
df['Has_Social_Weakness'] = (df['Social_Weakness'] == 'Yes').astype(int)
df['Has_Coping_Struggles'] = (df['Coping_Struggles'] == 'Yes').astype(int)

# Filtered Subset for Subjects Receiving Treatment
treated_df = df[df['treatment'].str.lower() == 'yes'].copy()

print("--- Initial Data Summary ---")
display(df.head())

# ==============================================================================
# SECTION 2: DEMOGRAPHICS & COPING STRUGGLES
# ==============================================================================
crosstab_pct = pd.crosstab(df['Gender'], df['Coping_Struggles'], normalize='index') * 100
print("\n--- Coping Struggles Percentage by Gender ---")
display(crosstab_pct)

# Plot: Coping Struggles by Gender
plt.figure(figsize=(8, 6))
ax = sns.countplot(data=df, x='Gender', hue='Coping_Struggles', palette='Set2')
plt.title('Coping Struggles by Gender', fontsize=14, fontweight='bold', pad=15)
plt.xlabel('Gender', fontsize=12)
plt.ylabel('Count', fontsize=12)
plt.legend(title='Coping Struggles', title_fontsize='11')
annotate_bars(ax)
plt.tight_layout()
plt.show()

# ==============================================================================
# SECTION 3: TREATED SUBJECTS OVERVIEW
# ==============================================================================
fig, axes = plt.subplots(1, 2, figsize=(12, 6))

# Plot 3A: Gender breakdown of treated subjects
treated_gender = treated_df['Gender'].value_counts()
axes[0].pie(
    treated_gender,
    labels=treated_gender.index,
    autopct='%1.1f%%',
    startangle=140,
    colors=['#66b3ff', '#ff9999'],
    explode=(0.05, 0)
)
axes[0].set_title('Gender Breakdown\n(Treated Subjects)', fontsize=12, fontweight='bold')

# Plot 3B: Detailed occupation breakdown by gender for treated subjects
occ_gender = treated_df.groupby(['Gender', 'Occupation']).size().unstack()
labels = [f"{g} - {o}" for g in occ_gender.index for o in occ_gender.columns]
sizes = [occ_gender.loc[g, o] for g in occ_gender.index for o in occ_gender.columns]

axes[1].pie(
    sizes,
    labels=labels,
    autopct='%1.1f%%',
    startangle=90,
    pctdistance=0.85
)
axes[1].set_title('Occupation Breakdown by Gender\n(Treated Subjects)', fontsize=12, fontweight='bold')

plt.tight_layout()
plt.show()

# ==============================================================================
# SECTION 4: TREATED OCCUPATIONS BY GENDER (FEMALE VS MALE)
# ==============================================================================
fig, axes = plt.subplots(1, 2, figsize=(14, 6))

female_treated = treated_df[treated_df['Gender'] == 'Female']['Occupation'].value_counts()
axes[0].pie(
    female_treated,
    labels=female_treated.index,
    autopct='%1.1f%%',
    startangle=140,
    colors=sns.color_palette('Pastel1')
)
axes[0].set_title('Treated Females by Occupation', fontsize=13, fontweight='bold')

male_treated = treated_df[treated_df['Gender'] == 'Male']['Occupation'].value_counts()
axes[1].pie(
    male_treated,
    labels=male_treated.index,
    autopct='%1.1f%%',
    startangle=140,
    colors=sns.color_palette('Pastel2')
)
axes[1].set_title('Treated Males by Occupation', fontsize=13, fontweight='bold')

plt.tight_layout()
plt.show()

# ==============================================================================
# SECTION 5: NON-OCCUPIED GROUP ANALYSIS (HOUSEWIFE, STUDENT, OTHERS)
# ==============================================================================
non_occupied_roles = ['Housewife', 'Student', 'Others']
not_occ_df = df[df['Occupation'].isin(non_occupied_roles)].copy()
no_work_int_df = not_occ_df[not_occ_df['Work_Interest'] == 'No']

fig, axes = plt.subplots(1, 2, figsize=(14, 6))

# Plot 5A: Work Interest Breakdown
work_int = not_occ_df['Work_Interest'].value_counts()
axes[0].pie(
    work_int,
    labels=[f"No Work Interest\n({work_int.get('No', 0):,})",
            f"Maybe\n({work_int.get('Maybe', 0):,})",
            f"Has Work Interest\n({work_int.get('Yes', 0):,})"],
    autopct='%1.1f%%',
    startangle=140,
    colors=['#ff6b6b', '#fca311', '#4ecdc4'],
    explode=(0.08, 0, 0)
)
axes[0].set_title('Work Interest Breakdown\n(Non-Occupied Group)', fontsize=13, fontweight='bold')

# Plot 5B: Mood Swings for 'No Work Interest' by Gender
mood_df = no_work_int_df.groupby(['Gender', 'Mood_Swings']).size().unstack()
mood_df.plot(kind='bar', ax=axes[1], color=['#2b2d42', '#8d99ae', '#edf2f4'], edgecolor='black')
axes[1].set_title('Mood Swings Distribution (No Work Interest, Non-Occupied)', fontsize=13, fontweight='bold')
axes[1].set_xlabel('Gender', fontsize=11)
axes[1].set_ylabel('Subject Count', fontsize=11)
axes[1].legend(title='Mood Swings Level')
axes[1].set_xticklabels(axes[1].get_xticklabels(), rotation=0)

plt.tight_layout()
plt.show()

# ==============================================================================
# SECTION 6: HEATMAP CORRELATIONS (MOOD SWINGS VS COPING & WORK INTEREST)
# ==============================================================================
fig, axes = plt.subplots(1, 2, figsize=(14, 5))

for idx, gender in enumerate(['Female', 'Male']):
    ct_female_male = pd.crosstab(
        df[df['Gender'] == gender]['Mood_Swings'],
        df[df['Gender'] == gender]['Coping_Struggles'],
        normalize='index'
    ) * 100

    cmap = 'PuRd' if gender == 'Female' else 'Blues'
    sns.heatmap(
        ct_female_male,
        annot=True,
        fmt='.1f',
        cmap=cmap,
        ax=axes[idx],
        cbar_kws={'label': 'Percentage (%)'},
        linewidths=1,
        annot_kws={"size": 12, "weight": "bold"}
    )
    axes[idx].set_title(f'{gender}s: Coping Struggles by Mood Swings (%)', fontsize=12, fontweight='bold')
    axes[idx].set_xlabel('Coping Struggles', fontsize=11)
    axes[idx].set_ylabel('Mood Swings Level', fontsize=11)

plt.tight_layout()
plt.show()

# ==============================================================================
# SECTION 7: STATISTICAL SUMMARY & CHI-SQUARE TESTS
# ==============================================================================
target_metrics = {
    'High_Mood_Swings': 'High Mood Swings (%)',
    'No_Work_Interest': 'No Work Interest (%)',
    'Is_Self_Employed': 'Self-Employed (%)',
    'Extended_Indoors': 'Extended Days Indoors (>15 Days) (%)',
    'Has_Social_Weakness': 'Social Weakness (%)',
    'Has_Coping_Struggles': 'Coping Struggles (%)'
}

print("=" * 80)
print("STATISTICAL SUMMARY: IMPACT OF TREATMENT ACROSS RISK PROFILES")
print("=" * 80)

summary_table = df.groupby(['family_history', 'Mental_Health_History', 'treatment'])[
    list(target_metrics.keys())
].mean() * 100

summary_table = summary_table.round(2).rename(columns=target_metrics)
display(summary_table)

print("\n" + "=" * 80)
print("CHI-SQUARE TEST OF INDEPENDENCE: TREATMENT VS OUTCOMES")
print("=" * 80)

chi2_results = []
for outcome_col, outcome_label in target_metrics.items():
    contingency_matrix = pd.crosstab(df['treatment'], df[outcome_col])
    chi2, p, dof, _ = chi2_contingency(contingency_matrix)
    chi2_results.append({
        'Outcome Metric': outcome_label,
        'Chi2 Statistic': round(chi2, 3),
        'p-value': p,
        'Statistically Significant (p < 0.05)': 'Yes' if p < 0.05 else 'No'
    })

chi2_df = pd.DataFrame(chi2_results)
display(chi2_df)

# ==============================================================================
# SECTION 8: TREATMENT SHIFT VISUALIZATION ACROSS OUTCOMES
# ==============================================================================
df_grouped = df.groupby(['Risk_Profile', 'treatment'])[list(target_metrics.keys())].mean().reset_index()
df_melted = pd.melt(
    df_grouped,
    id_vars=['Risk_Profile', 'treatment'],
    value_vars=list(target_metrics.keys()),
    var_name='Metric',
    value_name='Percentage'
)
df_melted['Percentage'] *= 100

fig, axes = plt.subplots(2, 3, figsize=(18, 11))
axes_flat = axes.flatten()

for idx, col in enumerate(target_metrics.keys()):
    ax = axes_flat[idx]
    sub_df = df_melted[df_melted['Metric'] == col]

    sns.barplot(
        data=sub_df,
        x='Risk_Profile',
        y='Percentage',
        hue='treatment',
        palette=['#e63946', '#2a9d8f'],
        ax=ax,
        edgecolor='black',
        alpha=0.9
    )
    ax.set_title(target_metrics[col], fontsize=12, fontweight='bold', pad=10)
    ax.set_xlabel('')
    ax.set_ylabel('Percentage (%)', fontsize=10)
    ax.set_ylim(0, max(sub_df['Percentage'].max() * 1.25, 50))
    ax.tick_params(axis='x', rotation=20, labelsize=9)
    ax.legend(title='Treatment', frameon=True)
    annotate_bars(ax, fmt="{:.1f}%", font_size=8)

plt.suptitle('Impact of Treatment on Patient Outcomes Across Risk Profiles', fontsize=15, fontweight='bold', y=1.02)
plt.tight_layout()
plt.show()
